---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      
      <!-- HERO SECTION -->
      <section class="space-y-4">
        <div class="inline-block rounded-full bg-neutral-100 dark:bg-neutral-800 px-3 py-1 text-xs font-semibold text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700">
          🏆 Certified Google Partner
        </div>
        <h1 class="text-3xl font-bold text-black dark:text-white tracking-tight">
          Maximize Your $10,000/Mo Google Ad Grant
        </h1>
        <p class="text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
          I help non-profits secure, audit, and scale free Google Search advertising budgets. Whether your account is underperforming, facing a 5% CTR suspension warning, or unspent, I deliver fast, text-based audits directly to your inbox.
        </p>
      </section>

      <!-- FEATURED AUDIT OFFER BOX -->
      <section class="rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 p-6 space-y-4 shadow-sm">
        <h3 class="text-xl font-bold text-black dark:text-white">
          📩 Request a Free Google Ad Grant Audit
        </h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          No video calls or high-pressure sales pitches. Get a comprehensive, text-based account review sent straight to your email within 24–48 hours.
        </p>
        
        <div class="space-y-2 pt-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">What’s included in your audit:</p>
          <ul class="text-sm space-y-1 list-disc list-inside text-neutral-700 dark:text-neutral-300">
            <li><strong>5% CTR Compliance Check:</strong> Flag keywords threatening your account status.</li>
            <li><strong>Wasted Budget Scan:</strong> Identify non-converting terms eating your $10k/mo grant.</li>
            <li><strong>GA4 Conversion Audit:</strong> Ensure donation and volunteer tracking work properly.</li>
          </ul>
        </div>

        <div class="pt-2">
          <a href="mailto:AcquireLift@gmail.com?subject=Google%20Ad%20Grant%20Audit%20Request" class="inline-block rounded-lg bg-black dark:bg-white text-white dark:text-black px-5 py-2.5 text-sm font-semibold hover:opacity-90 transition">
            Email AcquireLift@gmail.com for an Audit →
          </a>
        </div>
      </section>

      <!-- PROOF / BADGE PLACEHOLDER SECTION -->
      <section class="space-y-4">
        <h3 class="text-lg font-bold text-black dark:text-white">
          Verified Credentials & Proof
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 p-4 space-y-2">
            <span class="text-xs font-semibold text-neutral-500 uppercase">Status</span>
            <p class="font-bold text-black dark:text-white">Official Google Partner</p>
            <p class="text-xs text-neutral-600 dark:text-neutral-400">Specializing in non-profit Google Search campaigns and policy compliance.</p>
          </div>
          <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 p-4 space-y-2">
            <span class="text-xs font-semibold text-neutral-500 uppercase">Reviews</span>
            <p class="font-bold text-black dark:text-white">5-Star Upwork Rating</p>
            <p class="text-xs text-neutral-600 dark:text-neutral-400">Proven track record of scaling grant spend while maintaining >7% account CTR.</p>
          </div>
        </div>
      </section>

      <!-- LATEST ARTICLES -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-black dark:text-white">
            Articles & Guides
          </h3>
          <Link href="/blog" class="text-sm">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-3">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- CASE STUDIES -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-black dark:text-white">
            Client Proof & Case Studies
          </h3>
          <Link href="/work" class="text-sm">See all case studies</Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li class="rounded-lg border border-neutral-200 dark:border-neutral-800 p-4">
              <div class="text-xs opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white text-base mt-1">
                {entry.data.company}
              </div>
              <article class="mt-2 text-sm">
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <!-- FOOTER CONTACT -->
      <section class="border-t border-neutral-200 dark:border-neutral-800 pt-6">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          Ready to scale your grant or fix compliance issues? Email <a href="mailto:AcquireLift@gmail.com" class="underline text-black dark:text-white font-medium">AcquireLift@gmail.com</a>.
        </p>
      </section>

    </div>
  </Container>
</PageLayout>